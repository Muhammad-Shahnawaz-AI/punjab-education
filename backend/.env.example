CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./education.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Optional OpenAI-compatible API base URL; defaults to https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# Curriculum PDF uploads: local is for development or explicitly persistent shared volumes.
STORAGE_BACKEND=local
TEMPORARY_UPLOAD_DIRECTORY=./private-books
MAX_PDF_SIZE_BYTES=21474836480
UPLOAD_SESSION_TTL_SECONDS=86400
MULTIPART_CHUNK_SIZE_BYTES=8388608
MAX_CONCURRENT_UPLOADS=3
MAX_CONCURRENT_PROCESSING_JOBS=1
MAX_PDF_PAGES=5000
MAX_EXTRACTED_CHARACTERS=20000000
MAX_PROCESSING_SECONDS=21600
PROCESSING_LEASE_SECONDS=3600
WORKER_POLL_SECONDS=5
OCR_ENABLED=false

# For local storage in production, set true only when this path is on a durable volume
# mounted and shared by the API and worker. Prefer private S3-compatible object storage.
APP_ENV=development
LOCAL_BOOK_STORAGE_PERSISTENT=false

# S3-compatible private object storage (required with STORAGE_BACKEND=s3).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=